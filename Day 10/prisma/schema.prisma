// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // e.g., mysql://user:pass@localhost:3306/space_db
}

model Spacecraft {
  id          String   @id @default(uuid())
  name        String
  type        String
  launchDate  DateTime
  active      Boolean
  crewCapacity Int
  missions    Mission[]
}

model Mission {
  id           String      @id @default(uuid())
  name         String
  destination  String
  startDate    DateTime
  endDate      DateTime?
  spacecraft   Spacecraft  @relation(fields: [spacecraftId], references: [id])
  spacecraftId String
  crew         Astronaut[] @relation("MissionCrew")
  experiments  Experiment[]
}

model Astronaut {
  id       String    @id @default(uuid())
  name     String
  rank     String
  skills   AstronautSkill[]
  missions Mission[] @relation("MissionCrew")
}

model AstronautSkill {
  id          String    @id @default(uuid())
  skill       String
  astronaut   Astronaut @relation(fields: [astronautId], references: [id])
  astronautId String
}

model Experiment {
  id        String   @id @default(uuid())
  name      String
  field     String
  conductedOn DateTime
  result    String?
  mission   Mission  @relation(fields: [missionId], references: [id])
  missionId String
}

